---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => !data.draft);
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}
interface Props { project: CollectionEntry<'projects'> }
const { project } = Astro.props;
const { Content } = await render(project);
---
<Layout title={`${project.data.title} — Designer Portfolio`} description={project.data.description}>
  <article class="case-study">
    <a class="text-link" href={`${import.meta.env.BASE_URL}#work`}>← 모든 프로젝트</a>
    <p class="eyebrow">{project.data.category} / {project.data.year}</p>
    <h1>{project.data.title}</h1>
    <p class="intro">{project.data.description}</p>
    <div class="prose"><Content /></div>
  </article>
</Layout>
